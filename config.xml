<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="ph3Ha7N8EQ.BBNLIPTV"
        version="1.0.6">
        
    
    <!-- Samsung TV profile -->
    <tizen:profile name="tv-samsung"/>
    
    <!-- ✅ FIX 1: Lowered required_version to 2.4 for 2015 TVs -->
    <!-- ✅ FIX 2: Removed prelaunch (not supported in Tizen 2.x) -->
    <tizen:application
        id="ph3Ha7N8EQ.BBNLIPTV"
        package="ph3Ha7N8EQ"
        required_version="2.4"/>
    
    <content src="index.html"/>
    <name>BBNL IPTV</name>
    <icon src="icon.png"/>
    
    <!-- Access Origins (same as before) -->
    <access origin="*" subdomains="true"/>
    <access origin="https://bbnlnetmon.bbnl.in" subdomains="true"/>
    <access origin="http://bbnlnetmon.bbnl.in" subdomains="true"/>
    <access origin="http://livestream.bbnl.in" subdomains="true"/>
    <access origin="https://livestream.bbnl.in" subdomains="true"/>
    <access origin="http://livestream2.bbnl.in" subdomains="true"/>
    <access origin="https://livestream2.bbnl.in" subdomains="true"/>
    <access origin="http://livestream3.bbnl.in" subdomains="true"/>
    <access origin="https://livestream3.bbnl.in" subdomains="true"/>
    <access origin="https://images.bbnl.in" subdomains="true"/>
    <access origin="http://images.bbnl.in" subdomains="true"/>
    <access origin="https://cdn1.bbnl.in" subdomains="true"/>
    <access origin="http://cdn1.bbnl.in" subdomains="true"/>
    <access origin="https://api.ipify.org" subdomains="false"/>
    <access origin="http://api.ipify.org" subdomains="false"/>
    <access origin="https://api64.ipify.org" subdomains="false"/>
    <access origin="http://api64.ipify.org" subdomains="false"/>
    
    <tizen:allow-navigation href="*"/>
    
    <!-- ============================================ -->
    <!-- NETWORK PRIVILEGES -->
    <!-- ============================================ -->
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/network.get"/>
    <!-- ✅ FIX 3: Removed network.post (not in Tizen 2.4) -->
    <!-- Use XMLHttpRequest in JS instead -->
    <tizen:privilege name="http://tizen.org/privilege/download"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    
    <!-- ============================================ -->
    <!-- MEDIA PRIVILEGES -->
    <!-- ============================================ -->
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.audio"/>
    <!-- ✅ FIX 4: Removed volume.set (Tizen 3.0+ only) -->
    <!-- Let system remote handle volume natively -->
    <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
    
    <!-- ============================================ -->
    <!-- DEVICE INFO PRIVILEGES -->
    <!-- ============================================ -->
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://tizen.org/privilege/systeminfo"/>
    <!-- ✅ FIX 5: Removed tv.inputdevice (use keydown events instead) -->
    <tizen:privilege name="http://tizen.org/privilege/system"/>
    
    <!-- ✅ FIX 6: Removed mediacapture (unnecessary, causes issues) -->
    
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- ✅ FIX 7: Removed background-support (not needed, saves memory) -->
    <tizen:setting
        screen-orientation="landscape"
        hwkey-event="enable"/>
</widget>